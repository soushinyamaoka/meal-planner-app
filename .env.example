# アプリ種別（development にするとアプリ名に "(dev)" が付く / 本番は空白のままにする）
APP_VARIANT=development

# EASアカウントの所有者（Expoユーザー名）
EXPO_OWNER=your-expo-username

# Firebase（Firebaseコンソールから取得）
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# COOP API（VPSのAPIサーバー設定）
EXPO_PUBLIC_COOP_API_TOKEN=your-coop-api-token
EXPO_PUBLIC_COOP_API_URL=https://your-coop-api-host
EXPO_PUBLIC_WEB_API_URL=https://your-recipe-search-host
EXPO_PUBLIC_SCRAPER_API_URL=https://your-recipe-scraper-host

# 保育園献立インポートスクリプト（scripts/importNurseryMenu.mjs）専用
# 世帯メンバーのログイン情報（Firestore書き込み用）。実値は.envのみに置き、コミットしない
NURSERY_IMPORTER_EMAIL=your-login-email@example.com
NURSERY_IMPORTER_PASSWORD=your-login-password
